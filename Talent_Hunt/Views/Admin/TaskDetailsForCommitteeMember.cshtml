@model Talent_Hunt.Models.TaskDto

@{
    ViewBag.Title = "Task Details";
    //Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg rounded">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Task Details</h4>
            <a href="@Url.Action("ViewSubmissions", "Admin", new { taskId = Model.Id })"
               class="btn btn-light btn-sm shadow-sm border d-flex align-items-center gap-1"
               style="transition: all 0.2s ease-in-out;">
                <i class="bi bi-eye-fill"></i> View Submissions
            </a>
        </div>

        <div class="card-body">
            @if (Model != null)
            {
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="fw-bold text-primary">Start Time:</label>
                        <p class="mb-0">@DateTime.Parse(Model.TaskStartTime).ToString("hh:mm tt")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-primary">End Time:</label>
                        <p class="mb-0">@DateTime.Parse(Model.TaskEndTime).ToString("hh:mm tt")</p>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="fw-bold text-primary">Description:</label>
                    <p class="border p-3 rounded bg-light">@Model.Description</p>
                </div>

                <div class="card shadow-sm rounded-4 overflow-hidden task-card mx-auto" style="max-width: 400px;">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="http://localhost/TalentHunt1/Images/@Model.Image"
                             class="img-fluid rounded-3 border"
                             style="max-height: 240px; object-fit: cover; width: 100%;"
                             alt="Task Image" />
                    }
                    else
                    {
                        <div class="bg-light text-center py-5 rounded-3 border" style="color: #888;">
                            No Image Available
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning mt-3">Task details not found.</div>
            }
        </div>
    </div>
</div>
