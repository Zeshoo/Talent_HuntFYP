@model List<Talent_Hunt.Models.UserEventMarksViewModel>

@{
    ViewBag.Title = "Registered Event Results";
}

<h2 class="text-primary">Registered Event Results</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
else if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">No registered event results found.</div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <a href="@Url.Action("ShowUserMarks", "Admin", new { userId = ViewBag.UserId, eventId = item.EventId })" style="text-decoration: none; color: inherit;">
                    <div class="card shadow-sm rounded-4 h-100">
                        <img src="@($"http://localhost/TalentHunt1/Images/{item.EventPic ?? "default.png"}")"
                             class="card-img-top"
                             alt="Event Image"
                             style="height: 200px; object-fit: cover;" />
                        <div class="card-body">
                            <h5 class="card-title text-primary">@item.EventTitle</h5>
                            <p><strong>Overall Average:</strong> @(item.OverallAverage?.ToString("0.##") ?? "Not Available")</p>
                            <p><strong>Status:</strong> @item.EventStatus</p>

                            <hr />
                            <p><strong>Task Details:</strong></p>
                            <ul class="list-group list-group-flush">
                                @foreach (var task in item.TaskDetails)
                                {
                                    <li class="list-group-item">
                                        <b>@task.TaskDescription</b><br />
                                        Average Marks: @(task.TaskAverage?.ToString("0.##") ?? "Not Available")<br />
                                        Status: @task.MarksStatus
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
