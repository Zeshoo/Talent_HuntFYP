@model Talent_Hunt.Models.TaskDetailsWithSubmissionsViewModel

@{
    ViewBag.Title = "Task Submissions";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h3 class="mb-0">Task Submissions for @Model.EventTitle</h3>
            <p class="mb-0">Description: @Model.Description</p>
        </div>

        <div class="card-body">
            @if (Model.Submissions != null && Model.Submissions.Count > 0)
            {
                <div class="row">
                    @foreach (var submission in Model.Submissions)
                    {
                        var extension = System.IO.Path.GetExtension(submission.PathofSubmission ?? "").ToLower();
                        var isImage = extension == ".jpg" || extension == ".jpeg" || extension == ".png" || extension == ".gif";
                        var isPdf = extension == ".pdf";

                        <div class="col-md-4 mb-4">
                            <a href="@Url.Action("SubmissionDetails", "Admin", new { submissionId = submission.SubmissionID })" class="text-decoration-none text-dark d-block">
                                <div class="card h-100 shadow-sm border-0 rounded-4">
                                    <div class="rounded-top-4 d-flex align-items-center justify-content-center bg-light" style="height: 220px; overflow: hidden;">
                                        @if (isImage)
                                        {
                                            <img src="http://localhost/TalentHunt1/Images/@System.IO.Path.GetFileName(submission.PathofSubmission)"
                                                 class="img-fluid w-100"
                                                 style="object-fit: cover; height: 100%;"
                                                 alt="Submission Image"
                                                 onerror="this.onerror=null;this.src='/Content/Images/image-not-found.png';" />
                                        }
                                        else if (isPdf)
                                        {
                                            <i class="fas fa-file-pdf fa-4x text-danger"></i>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Preview Available</span>
                                        }
                                    </div>

                                    <div class="card-body">
                                        <h5 class="card-title">@submission.UserName</h5>
                                        <p class="card-text mb-1"><strong>Submitted:</strong> @submission.SubmissionTime.ToString("g")</p>

                                        <p class="card-text">
                                            <strong>Highest Marks:</strong>
                                            @if (submission.HighestMarks.HasValue)
                                            {
                                                @submission.HighestMarks
                                                <br />
                                                <small class="text-muted">By: @submission.HighestBy</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Marked</span>
                                            }
                                        </p>

                                        @if (submission.AllMarks != null && submission.AllMarks.Count > 1)
                                        {
                                            <p class="card-text"><strong>All Marks:</strong></p>
                                            <ul class="list-unstyled mb-0">
                                                @foreach (var mark in submission.AllMarks)
                                                {
                                                    <li>@mark.CommitteeMemberName: @mark.Marks1</li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">No submissions found for this task.</div>
            }
        </div>
    </div>
</div>
