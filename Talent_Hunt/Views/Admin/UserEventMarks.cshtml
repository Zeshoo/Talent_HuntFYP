@model List<Talent_Hunt.Models.UserEventMarksViewModel>

<h4 class="text-primary">Marks of Registered Events</h4>
<table class="table table-bordered mt-3">
    <thead class="table-light">
        <tr>
            <th>Event Title</th>
            <th>Marks</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventTitle</td>
                <td>@(item.Marks.HasValue ? item.Marks.Value.ToString("0.##") : "Not Available")</td>

            </tr>
        }
    </tbody>
</table>
