@model Talent_Hunt.Models.CompareTwoViewModel

@{
    ViewBag.Title = "Compare Submissions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center text-primary mt-4">Compare Submissions</h2>

@using (Html.BeginForm("SaveComparison", "Admin", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <input type="hidden" id="CommitteeMemberId" value="@ViewBag.CommitteeMemberId" />

    <div class="row mt-4">
        <!-- Submission 1 -->
        <div class="col-md-6 text-center border-end">
            <h5>@(Model.User1 != null ? Model.User1.Name : "No Name")</h5>

            <div class="d-flex justify-content-center align-items-start">
                <img id="submissionImage1"
                     src="http://localhost/TalentHunt1/Images/@Model.Submission1.PathofSubmission"
                     class="card-img-top me-3"
                     style="height: 300px; object-fit: contain; transition: transform 0.3s ease;" />

                <!-- Zoom Controls to the right of image -->
                <!--<div class="d-flex flex-column gap-2 align-items-start">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="zoomImage('submissionImage1', 1.2)">+</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="zoomImage('submissionImage1', 0.8)">−</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="resetZoom('submissionImage1')">Reset</button>
                </div>-->
            </div>

            <div class="form-group mt-3">
                <label for="Marks1">Marks:</label>
                <select name="Marks1" id="Marks1" class="form-select w-50 m-auto mb-3">
                    @for (int i = 0; i <= 10; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>

            @* Comment Section Disabled *@
            @*
                <div class="form-group">
                    <label for="Comment1">Comment:</label>
                    <textarea name="Comment1" id="Comment1" class="form-control mb-3" rows="3" placeholder="Write your feedback here..."></textarea>
                </div>
            *@

            <input type="hidden" name="SubmissionId1" id="SubmissionId1" value="@(Model.Submission1?.Id ?? 0)" />
        </div>

        <!-- Submission 2 -->
        <div class="col-md-6 text-center">
            <h5>@(Model.User2 != null ? Model.User2.Name : "No Name")</h5>

            <div class="d-flex justify-content-center align-items-start">
                <img id="submissionImage2"
                     src="http://localhost/TalentHunt1/Images/@Model.Submission2.PathofSubmission"
                     class="card-img-top me-3"
                     style="height: 300px; object-fit: contain; transition: transform 0.3s ease;" />

                <!-- Zoom Controls to the right of image -->
                <!--<div class="d-flex flex-column gap-2 align-items-start">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="zoomImage('submissionImage2', 1.2)">+</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="zoomImage('submissionImage2', 0.8)">−</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="resetZoom('submissionImage2')">Reset</button>
                </div>-->
            </div>

            <div class="form-group mt-3">
                <label for="Marks2">Marks:</label>
                <select name="Marks2" id="Marks2" class="form-select w-50 m-auto mb-3">
                    @for (int i = 0; i <= 10; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>

            @* Comment Section Disabled *@
            @*
                <div class="form-group">
                    <label for="Comment2">Comment:</label>
                    <textarea name="Comment2" id="Comment2" class="form-control mb-3" rows="3" placeholder="Write your feedback here..."></textarea>
                </div>
            *@

            <input type="hidden" name="SubmissionId2" id="SubmissionId2" value="@(Model.Submission2?.Id ?? 0)" />
        </div>
    </div>

    <div class="text-center mt-4">
        <button type="button" class="btn btn-success px-4" onclick="submitMarks()">Save Marks</button>
    </div>
}

<script>
    function submitMarks() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const committeeMemberId = document.getElementById("CommitteeMemberId").value;

        if (!committeeMemberId || committeeMemberId === "0") {
            alert("Committee Member ID is missing. Please log in again.");
            return;
        }

        const submission1 = {
            SubmissionId: document.getElementById("SubmissionId1").value,
            CommitteeMemberId: committeeMemberId,
            Marks: document.getElementById("Marks1").value,
            Comment: "", // Comment removed
            __RequestVerificationToken: token
        };

        const submission2 = {
            SubmissionId: document.getElementById("SubmissionId2").value,
            CommitteeMemberId: committeeMemberId,
            Marks: document.getElementById("Marks2").value,
            Comment: "", // Comment removed
            __RequestVerificationToken: token
        };

        Promise.all([
            fetch('/Admin/Marks', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: toFormData(submission1)
            }),
            fetch('/Admin/Marks', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: toFormData(submission2)
            })
        ]).then(([res1, res2]) => {
            if (res1.ok && res2.ok) {
                const submissionId1 = document.getElementById("SubmissionId1").value;
                alert("Marks submitted successfully.");
                window.location.href = "/Admin/SubmissionDetails?submissionId=" + submissionId1;
            } else {
                alert("Failed to submit both marks.");
            }
        }).catch(err => {
            console.error(err);
            alert("Error while submitting marks.");
        });
    }

    function toFormData(obj) {
        const formData = new FormData();
        for (let key in obj) {
            formData.append(key, obj[key]);
        }
        return formData;
    }

    // Zoom functionality per image
    const zoomLevels = {};

    function zoomImage(imageId, factor) {
        const img = document.getElementById(imageId);

        // Initialize zoom level if not present
        zoomLevels[imageId] = zoomLevels[imageId] || 1;

        // Calculate new zoom level
        const newZoom = zoomLevels[imageId] * factor;

        // Clamp zoom between 0.5 and 3
        if (newZoom < 0.5 || newZoom > 3) return;

        zoomLevels[imageId] = newZoom;
        img.style.transform = `scale(${zoomLevels[imageId]})`;
    }

    function resetZoom(imageId) {
        const img = document.getElementById(imageId);
        zoomLevels[imageId] = 1;
        img.style.transform = "scale(1)";
    }

   
</script>
