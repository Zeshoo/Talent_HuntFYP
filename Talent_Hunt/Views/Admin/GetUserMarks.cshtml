@model Talent_Hunt.Models.UserMarkViewModel

@{
    ViewBag.Title = "User Marks";
}

<h2>User Marks</h2>

@if (Model != null)
{
    <div class="card p-3">
        <p><strong>Student Name:</strong> @Model.StudentName</p>
        <p><strong>Committee Member:</strong> @Model.CommitteeMemberName</p>
        <p><strong>Marks:</strong> @Model.Marks</p>
    </div>
}
else if (ViewBag.Message != null)
{
    <p>@ViewBag.Message</p>
}
