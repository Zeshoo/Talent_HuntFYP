@model Talent_Hunt.Models.SubmissionViewModel

@{
    ViewBag.Title = "Submission Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-primary mt-4 text-center">Submission Details</h2>

<div class="card shadow p-4 mt-3" style="max-width: 700px; margin: auto;">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
    }

    <!-- Submission Image with Zoom Buttons in Top-Right Corner -->
    <div class="text-center mb-4 position-relative d-inline-block">
        <img id="submissionImage"
             src="http://localhost/TalentHunt1/Images/@Model.PathofSubmission"
             class="img-fluid rounded shadow-sm"
             style="max-height: 300px; object-fit: contain; transition: transform 0.3s ease;"
             alt="Submission Image" />

        <!-- Zoom Buttons in Top-Right -->
        <div style="position: absolute; top: 10px; right: 10px; display: flex; flex-direction: column; gap: 5px;">
            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    title="Zoom In"
                    onclick="zoomImage(1.2)">
                +
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    title="Zoom Out"
                    onclick="zoomImage(0.8)">
                −
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    title="Reset Zoom"
                    onclick="resetZoom()">
                Reset
            </button>
        </div>
    </div>

    <!-- Display submission details -->
    <div class="mb-3 row">
        <label class="col-sm-3 fw-bold">Submitted By:</label>
        <div class="col-sm-9">
            <p class="form-control-plaintext">@Model.UserName</p>
        </div>
    </div>

    <!-- Marks Dropdown -->
    <div class="row mb-3">
        <label class="col-sm-3 fw-bold" for="Marks">Assign Marks:</label>
        <div class="col-sm-9">
            <select id="Marks" class="form-select w-50 d-inline-block">
                @for (int i = 0; i <= 10; i++)
                {
                    <option value="@i">@i</option>
                }
            </select>
        </div>
    </div>

    <!-- Hidden CommitteeMemberId -->
    <input type="hidden" id="CommitteeMemberId" value="@ViewBag.CommitteeMemberId" />

    <!-- Submit Button -->
    <div class="text-center mt-4">
        <button type="button" class="btn btn-success px-4" onclick="submitMarks()">Submit Marks</button>
    </div>

    <!-- Compare Button -->
    <div class="text-center mt-4">
        <a href="@Url.Action("ViewSubmissionsforcompare", "Admin", new { taskId = Model.TaskID, currentSubmissionId = Model.Id })" class="btn btn-info px-4">Compare</a>
    </div>
</div>

<script>
    function submitMarks() {
        var marks = document.getElementById("Marks").value;
        var submissionId = "@Model.Id";
        var committeeMemberId = document.getElementById("CommitteeMemberId").value;

        if (!committeeMemberId || committeeMemberId === "0") {
            alert("Committee Member ID is missing. Please log in again.");
            return;
        }

        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        var formData = new FormData();
        formData.append("SubmissionId", submissionId);
        formData.append("CommitteeMemberId", committeeMemberId);
        formData.append("Marks", marks);
        formData.append("__RequestVerificationToken", token);

        fetch('/Admin/Marks', {
            method: 'POST',
            body: formData
        })
        .then(response => {
            if (response.redirected) {
                window.location.href = response.url;
            } else {
                alert("Failed to submit marks.");
            }
        })
        .catch(error => {
            alert("Error: " + error);
        });
    }

    // Zoom functionality
    let currentScale = 1;

    function zoomImage(factor) {
        const img = document.getElementById("submissionImage");
        currentScale *= factor;
        img.style.transform = `scale(${currentScale})`;
    }

    function resetZoom() {
        currentScale = 1;
        document.getElementById("submissionImage").style.transform = "scale(1)";
    }
</script>
