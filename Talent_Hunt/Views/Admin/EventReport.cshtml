@model Talent_Hunt.Models.EventReportViewModel

<h2>@Model.Title - Event Report</h2>
<p><strong>Date:</strong> @Model.EventDate.ToShortDateString()</p>
<p><strong>Participants:</strong> @Model.ParticipantCount</p>

<table class="table table-bordered mt-4">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Student Name</th>
            <th>Evaluators</th>
            <th>Avg. Marks</th>
            <th>Submission Time</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Submissions.Count; i++)
        {
            var submission = Model.Submissions[i];
            <tr>
                <td>@(i + 1)</td>

                <!-- ✅ Make student name clickable -->
                <td>
                    <a href="@Url.Action("GetUserMarks", "Admin", new { userId = submission.StudentId })">
                        @submission.StudentName
                    </a>
                </td>

                <td>@submission.CommitteeEvaluators</td>
                <td>@submission.AverageMarks</td>
                <td>@submission.SubmissionTime.ToString("g")</td>
            </tr>
        }
    </tbody>
</table>


