@model IEnumerable<Talent_Hunt.Models.Event>
@{
    ViewBag.Title = "Event";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f4f6f9;
    }

    .event-card {
        display: flex;
        background: white;
        border-radius: 15px;
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        transition: transform 0.2s ease-in-out;
        height: 180px;
        cursor: pointer;
        border: 1px solid #e3e6f0;
    }

        .event-card:hover {
            transform: scale(1.015);
            box-shadow: 0 10px 22px rgba(0, 0, 0, 0.15);
        }

    .event-image {
        width: 170px;
        object-fit: cover;
    }

    .event-details {
        padding: 15px;
        font-size: 15px;
        width: 100%;
        color: #333;
    }

    .event-title {
        font-weight: bold;
        font-size: 20px;
        color: #0d6efd;
        margin-bottom: 10px;
    }

    .event-attribute {
        font-weight: 500;
        color: #495057;
    }

    .filter-section {
        background: #ffffff;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    }

    .sidebar {
        background-color: #fff;
        border-left: 2px solid #dee2e6;
        height: 100vh;
        padding: 25px;
        position: fixed;
        right: 0;
        top: 0;
        width: 250px;
        display: none;
        z-index: 1050;
        box-shadow: -3px 0 10px rgba(0, 0, 0, 0.1);
    }

        .sidebar a {
            display: block;
            margin-bottom: 20px;
            font-weight: 500;
            font-size: 16px;
        }

    .main-content {
        padding-right: 20px;
    }

    .menu-toggle {
        background-color: #0d6efd;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .menu-toggle:hover {
            background-color: #0b5ed7;
        }

    .menu-button-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .badge {
        background-color: #e9ecef;
        color: #212529;
        border-radius: 5px;
        padding: 3px 8px;
        margin-left: 5px;
        font-size: 13px;
    }
</style>

<!-- Sidebar -->
<div class="sidebar" id="sidebarMenu">
    <h5 class="text-dark mb-4"><i class="fas fa-bars me-2"></i> Menu</h5>
    <a class="btn btn-outline-success w-100" href="@Url.Action("CreateEvent", "Admin")">
        <i class="fas fa-plus me-1"></i> Add Event
    </a>
    <a class="btn btn-outline-primary w-100" href="@Url.Action("ShowAllCommiteeMembers", "Admin")">
        <i class="fas fa-users me-1"></i> Show All Members
    </a>
    <a class="btn btn-outline-secondary w-100" href="@Url.Action("LeaderBoard", "Admin")">
        <i class="fas fa-file-alt me-1"></i> Leader Board
    </a>
</div>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12 main-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="menu-button-wrapper">
                    <button class="menu-toggle" onclick="toggleSidebar()">
                        <i class="fas fa-bars me-2"></i> Menu
                    </button>
                    <h2 class="text-primary fw-bold mb-0">
                        <i class="fas fa-calendar-alt me-2"></i> @ViewBag.Title
                    </h2>
                </div>
            </div>

            <div class="filter-section">
                <h6><i class="fas fa-filter me-2"></i>Filter Events</h6>
                <div class="form-check form-check-inline">
                    <input class="form-check-input eventFilter" type="radio" name="filter" value="all" checked />
                    <label class="form-check-label">All Events</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input eventFilter" type="radio" name="filter" value="current" />
                    <label class="form-check-label">Current Events</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input eventFilter" type="radio" name="filter" value="upcoming" />
                    <label class="form-check-label">Upcoming Events</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input eventFilter" type="radio" name="filter" value="past" />
                    <label class="form-check-label">Past Events</label>
                </div>
            </div>

            <div class="row" id="eventContainer">
                @foreach (var eventItem in Model)
                {
                    <div class="col-md-6 mb-4 event-item"
                         data-start="@eventItem.RegStartDate"
                         data-end="@eventItem.RegEndDate">
                        <div class="event-card" onclick="location.href='@Url.Action("EventDetails", "Admin", new { id = eventItem.Id })'">
                            <img src="@($"http://localhost/TalentHunt1/Images/{eventItem.Image ?? "default.png"}")" alt="Event Image" class="event-image" />
                            <div class="event-details">
                                <div class="event-title">@eventItem.Title</div>
                                <div><span class="event-attribute"><i class="far fa-calendar-alt me-1"></i>Reg. Start:</span> <span class="badge">@eventItem.RegStartDate</span></div>
                                <div><span class="event-attribute"><i class="far fa-calendar-check me-1"></i>Reg. End:</span> <span class="badge">@eventItem.RegEndDate</span></div>
                                <div><span class="event-attribute"><i class="fas fa-calendar-day me-1"></i>Event Date:</span> <span class="badge">@eventItem.EventDate</span></div>
                                <div><span class="event-attribute"><i class="far fa-clock me-1"></i>Start Time:</span> <span class="badge">@eventItem.EventStartTime</span></div>
                                <div><span class="event-attribute"><i class="far fa-clock me-1"></i>End Time:</span> <span class="badge">@eventItem.EventEndTime</span></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function toggleSidebar() {
        $("#sidebarMenu").slideToggle("fast");
    }

    function filterEvents(type) {
        const now = new Date();
        $(".event-item").each(function () {
            const start = new Date($(this).data("start"));
            const end = new Date($(this).data("end"));

            let show = true;
            if (type === "current") {
                show = start <= now && end >= now;
            } else if (type === "upcoming") {
                show = start > now;
            } else if (type === "past") {
                show = end < now;
            }

            $(this).toggle(show);
        });
    }

    $(document).ready(function () {
        $('.eventFilter').on('change', function () {
            const value = $(this).val();
            filterEvents(value);
        });
    });
</script>

@section Scripts {
    <script>
        $(document).ready(function () {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                if (typeof toastr !== 'undefined') {
                    toastr.success('@TempData["SuccessMessage"]');
                }
                </text>
            }

            if (sessionStorage.getItem('taskCreated') === 'true') {
                var alertDiv = $('<div class="alert alert-success alert-dismissible fade show">' +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                    '<strong>Success!</strong> Task created successfully.' +
                    '</div>');

                $('.content-wrapper').prepend(alertDiv);

                if (typeof toastr !== 'undefined') {
                    toastr.success('Task created successfully!');
                }

                sessionStorage.removeItem('taskCreated');
            }
        });
    </script>
}
