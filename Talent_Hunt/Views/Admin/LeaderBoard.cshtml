@model List<Talent_Hunt.Models.LeaderBoard>

@{
    ViewBag.Title = "Leaderboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="text-center text-primary mb-5"><i class="fas fa-trophy me-2"></i>Event Leaderboard</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    else if (Model != null && Model.Any())
    {
        foreach (var eventItem in Model)
        {
            <div class="card mb-5 shadow rounded-4 border-0">
                <div class="card-header bg-gradient bg-primary text-white rounded-top-4">
                    <h4 class="mb-0">@eventItem.EventTitle</h4>
                </div>

                @if (eventItem.TopThreeToppers != null && eventItem.TopThreeToppers.Any())
                {
                    <div class="card-body p-0">
                        <table class="table table-striped table-hover mb-0 text-center align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width: 80px;">Rank</th>
                                    <th>Student Name</th>
                                    <th>Average Marks</th>
                                    @*<th>Submission Time</th>*@
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < eventItem.TopThreeToppers.Count; i++)
                                {
                                    var topper = eventItem.TopThreeToppers[i];
                                    string medal = i == 0 ? "🥇" : i == 1 ? "🥈" : "🥉";
                                    <tr>
                                        <td class="fs-4">@medal</td>
                                        <td class="fw-semibold">@topper.StudentName</td>
                                        <td class="text-success fw-bold">@topper.AverageMarks.ToString("0.##")</td>
                                        @*<td class="text-muted">@topper.SubmissionTime</td>*@
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="card-body text-muted">No toppers found for this event.</div>
                }
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">No leaderboard data available.</div>
    }
</div>
